{% extends 'base.html.twig' %}

{% block title %}Portfolio - Maxime Bourron - Veilles{% endblock %}
{% block description %}Ma veille technologique sur la sécurité applicative à l'ère de l'IA agentique.{% endblock %}

{% block body %}
<main id="contenu" class="veilles">
    <h1>Veilles technologiques</h1>

    {% for veille in veilles %}
        <section class="veilles-section">
            <div class="veille-entete">
                <h2>{{ veille.titre }}</h2>
                <p class="veille-presentation">{{ veille.presentation|nl2br }}</p>
            </div>

            <div class="veille-articles">
                {% for article in veille.articles %}
                    <article class="carte veille-article" data-controller="reveal">
                        {% if article.image %}
                            <span class="veille-article-icone">
                                <span class="icone" style="--icone: url('{{ asset('images/' ~ article.image) }}')"></span>
                            </span>
                        {% endif %}

                        <div class="veille-article-contenu">
                            <h3 class="veille-article-titre">{{ article.titre }}</h3>
                            <p class="veille-article-meta">{{ article.source }} · {{ article.datePublication|format_date(pattern: 'd MMMM yyyy') }}</p>
                            <p class="veille-article-resume">{{ article.resume }}</p>
                            <a href="{{ article.url }}" class="bouton bouton-plein bouton-petit" target="_blank" rel="noopener">Lire l'article</a>
                        </div>
                    </article>
                {% endfor %}
            </div>
        </section>
    {% endfor %}
</main>
{% endblock %}
