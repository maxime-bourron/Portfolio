{% extends 'base.html.twig' %}

{% block title %}Portfolio - Maxime Bourron - {{ projet.titre }}{% endblock %}

{% block body %}
<main class="projet-detail">
    <a href="{{ path('app_projets') }}" class="lien-retour">← Retour aux projets</a>

    <div class="carte projet-entete" data-controller="reveal">
        <h1>{{ projet.titre }}</h1>
        <p class="projet-entete-cadre">{{ projet.cadre }}</p>

        <div class="projet-meta">
            <span class="tag">{{ projet.typeProjet.value }}</span>
            <span class="projet-dates">{{ include('projets/_dates.html.twig') }}</span>
        </div>

        {% if projet.urlCode or projet.urlDemo %}
            <div class="projet-boutons">
                {% if projet.urlDemo %}
                    <a href="{{ projet.urlDemo }}" class="bouton bouton-plein" target="_blank" rel="noopener">Voir le site</a>
                {% endif %}
                {% if projet.urlCode %}
                    <a href="{{ projet.urlCode }}" class="bouton bouton-contour" target="_blank" rel="noopener">Code source</a>
                {% endif %}
            </div>
        {% endif %}
    </div>

    <img src="{{ asset('images/' ~ projet.image) }}" alt="Aperçu du projet {{ projet.titre }}" class="projet-detail-image" data-controller="reveal">

    <section class="projet-section" data-controller="reveal">
        <h2>Contexte et objectifs</h2>
        <p>{{ projet.contexte|nl2br }}</p>
    </section>

    <section class="projet-section" data-controller="reveal">
        <h2>Réalisations</h2>
        <ul class="projet-realisations">
            {% for realisation in projet.realisations|split("\n") %}
                {% if realisation|trim %}
                    <li>{{ realisation|trim }}</li>
                {% endif %}
            {% endfor %}
        </ul>
    </section>

    <section class="projet-section" data-controller="reveal">
        <h2>Compétences et technologies</h2>

        <h3>Technologies</h3>
        <ul class="projet-tags">
            {% for techno in projet.technos|split(',') %}
                <li class="tag">{{ techno|trim }}</li>
            {% endfor %}
        </ul>

        {% if projet.softSkills %}
            <h3>Savoir-être</h3>
            <ul class="projet-tags">
                {% for softSkill in projet.softSkills|split(',') %}
                    <li class="tag">{{ softSkill|trim }}</li>
                {% endfor %}
            </ul>
        {% endif %}
    </section>

    {% if projet.resultats %}
        <section class="projet-section" data-controller="reveal">
            <h2>Résultats et livrables</h2>
            <p>{{ projet.resultats|nl2br }}</p>
        </section>
    {% endif %}

    {% if projet.bilan %}
        <section class="projet-section" data-controller="reveal">
            <h2>Bilan</h2>
            <p>{{ projet.bilan|nl2br }}</p>
        </section>
    {% endif %}
</main>
{% endblock %}
