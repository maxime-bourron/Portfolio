{% extends 'base.html.twig' %}

{% block title %}Portfolio - Maxime Bourron{% endblock %}

{% block body %}
<main>
    <div class="presentation">
        <div class="presentation-text">
            <div class="presentation-title">
                <h1>Salut, moi c'est <span class="texte-degrade">{{ profil.prenom }}</span></h1>
                <p class="accroche">{{ profil.accroche }}</p>
            </div>

            <div class="presentation-description">
                <p>{{ profil.presentation }}</p>
            </div>

            <div class="presentation-action">
                <a href="#">Mon CV</a>
                <a href="#">Me contacter</a>
            </div>
        </div>
        <img src="{{ asset('images/' ~ profil.photo) }}" alt="Photo de profil" class="presentation-img">
    </div>

    <div class="line"></div>

    <div class="information">
        <h2>Informations</h2>
        <div class="information-detail">
            <div class="information-detail-item">
                <h3>Parcours</h3>
                <p>{{ profil.parcours }}</p>
            </div>

            <div class="information-detail-item">
                <h3>Objectif</h3>
                <p>{{ profil.objectif }}</p>
            </div>

            <div class="information-detail-item">
                <h3>Perspectives</h3>
                <p>{{ profil.perspectives }}</p>
            </div>
        </div>
        <div class="information-cards">
            <div class="carte-profil">
                <img src="{{ asset('images/' ~ profil.photo) }}" alt="Photo de {{ profil.prenom }} {{ profil.nom }}" class="profil-img">
                <h3 class="carte-profil-nom">{{ profil.prenom }} {{ profil.nom }}</h3>

                <div class="carte-profil-liens">
                    <a href="{{ profil.urlGithub }}" target="_blank" rel="noopener noreferrer" aria-label="Mon GitHub">
                        <img src="{{ asset('images/icones/github.svg') }}" alt="">
                    </a>

                    <a href="{{ profil.urlLinkedin }}" target="_blank" rel="noopener noreferrer" aria-label="Mon LinkedIn">
                        <img src="{{ asset('images/icones/linkedin.svg') }}" alt="">
                    </a>
                </div>
            </div>

            <div class="carte-info">
                <h3>Études</h3>
                <img src="{{ asset('images/' ~ profil.logoEtudes) }}" alt="Études actuelles" class="carte-logo">
                <p>{{ profil.statutEtudes }}</p>
            </div>

            <div class="carte-info">
                <h3>Travail</h3>
                <img src="{{ asset('images/' ~ profil.logoTravail) }}" alt="Emploi actuel" class="carte-logo">
                <p>{{ profil.statutTravail }}</p>
            </div>
        </div>
    </div>
</main>
{% endblock %}
